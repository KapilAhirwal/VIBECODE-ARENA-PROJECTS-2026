{
  "name": "cybershield-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" README.md package.json tsconfig.json index.html",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/detector.test.ts"
  },
  "dependencies": {
    "framer-motion": "^14.6.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
